library(msa)
library(phangorn)
library(phytools)
R35_dnabin <- as.DNAbin(R35_aligned)
R35_dist   <- dist.dna(R35_dnabin, model = "K80", gamma = TRUE)
R35_tree   <- nj(R35_dist)
R35_tree   <- root(R35_tree, outgroup = "Alligator", resolve.root = TRUE)
plot(R35_tree)
